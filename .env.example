# Copy to .env and adjust. Only EXPO_PUBLIC_* values are available inside the app.

# Address of the MySawari backend (the separate mysawari_customer_backend project).
#   iOS simulator / Android emulator with the backend on this computer: leave unset.
#   Real phone on the same Wi-Fi:  http://<this computer's LAN IP>:5001
#   Deployed backend:              https://your-backend-domain
EXPO_PUBLIC_API_BASE_URL=
