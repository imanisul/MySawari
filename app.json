{
  "expo": {
    "name": "MySawari",
    "slug": "car-rental-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MySawari.png",
    "scheme": "car-rental-mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/640f7262-fb50-4d44-8d81-3c497c59c448"
    },
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9F8"
    },
    "ios": {
      "supportsTablet": false,
      "icon": "./assets/images/MySawari.png"
    },
    "android": {
      "package": "com.anisul17.mysawari",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F9F8"
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mysawari.app/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "expo-secure-store",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "640f7262-fb50-4d44-8d81-3c497c59c448"
      }
    },
    "owner": "anisul17"
  }
}
