{
  "expo": {
    "name": "MySawari",
    "slug": "car-rental-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "car-rental-mobile",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F9F9F8"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.anisul17.mysawari"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mysawari.app/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "640f7262-fb50-4d44-8d81-3c497c59c448"
      }
    },
    "owner": "anisul17"
  }
}
