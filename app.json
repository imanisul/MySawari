{
  "expo": {
    "name": "MySawari",
    "slug": "car-rental-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/MySawari.png",
    "scheme": "car-rental-mobile",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7eae244d-1043-4c00-b2af-e384e4a921e4",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "bundleIdentifier": "com.mysawari.customer",
      "backgroundColor": "#FAFAF9",
      "supportsTablet": false,
      "icon": "./assets/images/MySawari.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "MySawari uses your location to find nearby drivers and set pickup points.",
        "NSCameraUsageDescription": "MySawari uses your camera so you can take photos of your trip for reviews, and verify your identity or driver's license for rentals.",
        "NSPhotoLibraryUsageDescription": "MySawari uses your photo library so you can add trip photos to your reviews and upload documents for identity verification."
      },
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "backgroundColor": "#FAFAF9",
      "package": "com.mysawari.customer",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F9F8"
      }
    },
    "notification": {
      "icon": "./assets/images/notification_icon.png",
      "color": "#D3302D"
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mysawari.app/"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "visibility": "visible",
          "behavior": "inset-swipe",
          "backgroundColor": "#00000000"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "expo-secure-store",
      "expo-notifications",
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "7eae244d-1043-4c00-b2af-e384e4a921e4"
      }
    },
    "owner": "mysawari"
  }
}
