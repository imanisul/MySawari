{
  "expo": {
    "name": "MySawari",
    "slug": "car-rental-mobile",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/images/MySawari.png",
    "scheme": "car-rental-mobile",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.mysawari.customer",
      "buildNumber": "2",
      "backgroundColor": "#FAFAF9",
      "supportsTablet": false,
      "icon": "./assets/images/MySawari.png",
      "infoPlist": {
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "MySawari uses your location while the app is open to suggest your pickup location and nearby places.",
        "NSCameraUsageDescription": "MySawari uses your camera so you can take photos of your trip to add to a review.",
        "NSPhotoLibraryUsageDescription": "MySawari uses your photo library so you can choose trip photos to add to a review."
      }
    },
    "android": {
      "backgroundColor": "#FAFAF9",
      "package": "com.mysawari.customer",
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "versionCode": 5,
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#F9F9F8"
      }
    },
    "androidStatusBar": {
      "translucent": true,
      "backgroundColor": "#00000000"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://mysawari.app/"
        }
      ],
      [
        "expo-navigation-bar",
        {
          "position": "absolute",
          "hidden": false,
          "behavior": "inset-swipe",
          "backgroundColor": "#00000000"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/transparent.png",
          "imageWidth": 1,
          "resizeMode": "contain",
          "backgroundColor": "#FAFAF9"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-updates",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MySawari uses your location while the app is open to suggest your pickup location and nearby places.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "MySawari uses your camera so you can take photos of your trip to add to a review.",
          "microphonePermission": false,
          "recordAudioAndroidPermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification_icon.png",
          "color": "#D3302D"
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "eas": {
        "projectId": "d7cbac30-5e68-40ef-b527-8babd470346e"
      }
    },
    "owner": "masudalom"
  }
}
